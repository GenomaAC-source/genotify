# Server Configuration
PORT=3060
NODE_ENV=production

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:5432/database

# Security - API Key for authenticating requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=your-secure-api-key-here

# Discord integration (avvia il client Discord nello stesso processo dell'API)
# Se omessi, il bot non parte ma l'API resta funzionante
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-server-id

# Optional: External integrations (for future features)
# PLUTIO_API_KEY=
# GOOGLE_CALENDAR_CREDENTIALS=
