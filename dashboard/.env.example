# Database (same as backend)
DATABASE_URL=postgresql://user:password@host:5432/database

# NextAuth Configuration
NEXTAUTH_URL=https://your-dashboard.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: https://your-dashboard.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Genotify API (used by server-side proxy routes, e.g. channels resync)
GENOTIFY_API_URL=https://your-genotify.onrender.com
GENOTIFY_API_KEY=same-value-as-genotify-API_KEY
